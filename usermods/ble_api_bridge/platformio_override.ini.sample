; Copy to the repository root as platformio_override.ini.
; USB updates only. Retain every other base feature, usermod, and filesystem capacity.
[ble_api_bridge]
build_flags =
  -D WLED_DISABLE_OTA
  -D CONFIG_BT_NIMBLE_ROLE_CENTRAL_DISABLED
  -D CONFIG_BT_NIMBLE_ROLE_OBSERVER_DISABLED
  -D MYNEWT_VAL_BLE_SM_SC_ONLY=1

; Classic ESP32 needs a BLE-only controller to leave instruction RAM for DMX
; and AudioReactive. Rebuild the same current SDK; no WLED integrations are removed.
[ble_api_bridge_esp32]
build_flags =
  ; WLED enables this warning; SDK components compiled with -Werror contain shadows.
  -Wno-error=shadow=compatible-local
custom_sdkconfig =
  CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
  CONFIG_BTDM_CTRL_MODE_BTDM=n
  CONFIG_COMPILER_CXX_EXCEPTIONS=n
  CONFIG_COMPILER_CXX_RTTI=n

[env:esp32dev_ble_api_bridge]
extends = env:esp32dev
extra_scripts = ${env:esp32dev.extra_scripts}
  pre:pio-scripts/ble_sdk.py
custom_sdkconfig = ${ble_api_bridge_esp32.custom_sdkconfig}
custom_usermods = ${env:esp32dev.custom_usermods} ble_api_bridge
board_build.partitions = tools/WLED_ESP32_4MB_NOOTA.csv
board_build.app_partition_name = app0
build_flags = ${env:esp32dev.build_flags} ${ble_api_bridge.build_flags} ${ble_api_bridge_esp32.build_flags}
  -D WLED_RELEASE_NAME=\"ESP32_BLE_NOOTA\"
build_unflags = ${env:esp32dev.build_unflags}
  -fexceptions
  -D WLED_RELEASE_NAME=\"ESP32_NOOTA\"
  -D WLED_ENABLE_AOTA

[env:esp32s3dev_ble_api_bridge]
extends = env:esp32s3dev_8MB_opi
custom_usermods = ${env:esp32s3dev_8MB_opi.custom_usermods} ble_api_bridge
board_build.partitions = tools/WLED_ESP32_8MB_NOOTA.csv
board_build.app_partition_name = app0
build_flags = ${env:esp32s3dev_8MB_opi.build_flags} ${ble_api_bridge.build_flags}
  -D WLED_RELEASE_NAME=\"ESP32-S3_8MB_opi_BLE_NOOTA\"
build_unflags = ${env:esp32s3dev_8MB_opi.build_unflags}
  -D WLED_RELEASE_NAME=\"ESP32-S3_8MB_opi\"
  -D WLED_ENABLE_AOTA

[env:esp32dev_8MB_ble_api_bridge]
extends = env:esp32dev_8M
extra_scripts = ${env:esp32dev_8M.extra_scripts}
  pre:pio-scripts/ble_sdk.py
custom_sdkconfig = ${ble_api_bridge_esp32.custom_sdkconfig}
custom_usermods = ${env:esp32dev_8M.custom_usermods} ble_api_bridge
board_build.partitions = tools/WLED_ESP32_8MB_NOOTA.csv
board_build.app_partition_name = app0
build_flags = ${env:esp32dev_8M.build_flags} ${ble_api_bridge.build_flags} ${ble_api_bridge_esp32.build_flags}
  -D WLED_RELEASE_NAME=\"ESP32_8M_BLE_NOOTA\"
build_unflags = ${env:esp32dev_8M.build_unflags}
  -fexceptions
  -D WLED_RELEASE_NAME=\"ESP32_8M\"
  -D WLED_ENABLE_AOTA
